<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ch.admin.bj.swiyu</groupId>
    <artifactId>swiyu-core-business-service</artifactId>
    <version>4.2.4-SNAPSHOT</version>
    <packaging>pom</packaging>
    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <!--
            Attention: when ever you update this version, check whether we can remove a CVE-OVERRIDE
            from the dependencyManagement section
         -->
        <!-- see https://github.com/jeap-admin-ch/jeap-spring-boot-parent/blob/main/CHANGELOG.md -->
        <version>41.3.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <archunit-junit5.version>1.5.0</archunit-junit5.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <spotless-maven-plugin.version>3.10.2</spotless-maven-plugin.version>
        <cleanthat.version>2.25</cleanthat.version>
        <prettier.version>3.8.1</prettier.version>
        <prettier-plugin-java.version>2.8.1</prettier-plugin-java.version>
        <sonar.scm.disabled>true</sonar.scm.disabled>
        <!-- CVE-OVERRIDE start -->
        <!-- The embedded Tomcat that the Spring Boot parent pins, 11.0.23, carries three critical
             issues, all of them authentication or authorisation bypasses: CVE-2026-65182 (security
             constraint bypass), CVE-2026-65905 (replay against the DIGEST authenticator) and
             CVE-2026-68525 (FORM authentication bypass). 11.0.25 is the first release with all three
             fixed.

             Set as a property rather than a dependencyManagement entry on tomcat-embed-core: the
             starter also brings tomcat-embed-el and tomcat-embed-websocket, and the property is what
             the Spring Boot BOM reads for all three. Pinning only the one Trivy names would leave the
             other two behind and mix versions inside one Tomcat.

             Remove once the jeap parent brings a Spring Boot that pins 11.0.25 or later. -->
        <tomcat.version>11.0.25</tomcat.version>
        <!-- CVE-OVERRIDE end -->
    </properties>


    <name>swiyu-core-business-service</name>
    <description>Parent aggregator for swiyu core business service and registry modules</description>

    <modules>
        <module>swiyu-core-business-service-app</module>
        <module>swiyu-core-business-service-registry-identifier</module>
        <module>swiyu-core-business-service-registry-status</module>
        <module>swiyu-discrete-validator-client</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.admin.bj.swiyu</groupId>
                <artifactId>swiyu-core-business-service-registry-identifier</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bj.swiyu</groupId>
                <artifactId>swiyu-core-business-service-registry-status</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bj.swiyu</groupId>
                <artifactId>swiyu-discrete-validator-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- CVE-OVERRIDE start -->
            <dependency>
<!--            Allocation of Resources Without Limits or Throttling (new) [High Severity][https://security.snyk.io/vuln/SNYK-JAVA-COMFASTERXMLJACKSONCORE-20059683] in com.fasterxml.jackson.core:jackson-databind@2.22.2-->
<!--            introduced by com.networknt:json-schema-validator@1.5.9 > com.fasterxml.jackson.core:jackson-databind@2.22.2-->
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>2.22.3</version>
            </dependency>
            <dependency>
<!--            Allocation of Resources Without Limits or Throttling [High Severity][https://security.snyk.io/vuln/SNYK-JAVA-COMFASTERXMLJACKSONCORE-20059179] in com.fasterxml.jackson.core:jackson-core@2.22.2-->
<!--            introduced by ch.admin.bj.swiyu:swiyu-discrete-validator-client@4.2.1-SNAPSHOT > com.fasterxml.jackson.jakarta.rs:jackson-jakarta-rs-base@2.22.2 > com.fasterxml.jackson.core:jackson-core@2.22.2-->
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>2.22.3</version>
            </dependency>
            <dependency>
<!--            Allocation of Resources Without Limits or Throttling (new) [High Severity][https://security.snyk.io/vuln/SNYK-JAVA-COMFASTERXMLJACKSONCORE-19778370] in com.fasterxml.jackson.core:jackson-databind@2.22.1-->
<!--            introduced by com.networknt:json-schema-validator@1.5.9 > com.fasterxml.jackson.core:jackson-databind@2.22.1-->
                <groupId>com.networknt</groupId>
                <artifactId>json-schema-validator</artifactId>
                <version>3.0.6</version>
            </dependency>
            <dependency>
<!--            Out-of-bounds Write [High Severity][https://security.snyk.io/vuln/SNYK-JAVA-ORGXERIALSNAPPY-19778376] in org.xerial.snappy:snappy-java@1.1.10.7-->
<!--            introduced by ch.admin.bit.jeap:jeap-messaging-infrastructure-kafka-test@18.14.0 > org.springframework.kafka:spring-kafka-test@4.1.1 > org.apache.kafka:kafka-clients@4.2.1 > org.xerial.snappy:snappy-java@1.1.10.7-->
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.8</version>
            </dependency>
            <dependency>
<!--            Allocation of Resources Without Limits or Throttling [High Severity][https://security.snyk.io/vuln/SNYK-JAVA-TOOLSJACKSONCORE-20059180] in tools.jackson.core:jackson-core@3.2.2-->
<!--            introduced by ch.admin.bj.swiyu:swiyu-discrete-validator-client@4.2.1-SNAPSHOT > tools.jackson.core:jackson-databind@3.2.2 > tools.jackson.core:jackson-core@3.2.2-->
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-core</artifactId>
                <version>3.2.3</version>
            </dependency>
            <dependency>
<!--            Allocation of Resources Without Limits or Throttling [High Severity][https://security.snyk.io/vuln/SNYK-JAVA-TOOLSJACKSONCORE-20059682] in tools.jackson.core:jackson-databind@3.2.2-->
<!--            introduced by ch.admin.bj.swiyu:swiyu-discrete-validator-client@4.2.1-SNAPSHOT > tools.jackson.core:jackson-databind@3.2.2-->
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>3.2.3</version>
            </dependency>
            <dependency>
<!--            Allocation of Resources Without Limits or Throttling [High Severity][https://security.snyk.io/vuln/SNYK-JAVA-TOOLSJACKSONCORE-19778371] in tools.jackson.core:jackson-databind@3.1.5-->
<!--            introduced by ch.admin.bj.swiyu:swiyu-discrete-validator-client@4.0.0-SNAPSHOT-20260916071558-f59ff90f > tools.jackson.core:jackson-databind@3.1.5-->
                <groupId>tools.jackson.core</groupId>
                <artifactId>jackson-databind-nullable</artifactId>
                <version>3.1.6</version>
            </dependency>
            <!-- CVE-OVERRIDE end -->

            <!-- commons-io is explicitly managed here because it is not provided by Spring Boot or jeap-parent.
                 Version 2.22.0 is used by swiyu-discrete-validator-client. -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>

        <plugins>
            <plugin>
                <!-- See https://www.baeldung.com/checkstyle-java for more info -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <!-- See https://checkstyle.sourceforge.io/config.html -->
                    <configLocation>google_checks.xml</configLocation>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <upToDateChecking>
                        <!--
                            upToDateChecking creates a cache in the target directory to only reformat modified files — improves performance.
                            Enabled by default since version 2.35.0, but explicitly set here so it can be temporarily disabled locally if merge issues occur.
                        -->
                        <enabled>true</enabled>
                    </upToDateChecking>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <cleanthat>
                            <version>${cleanthat.version}</version>
                            <sourceJdk>${java.version}</sourceJdk>
                            <mutators>
                                <mutator>SafeAndConsensual</mutator>
                                <mutator>SafeButNotConsensual</mutator>
                            </mutators>
                            <includeDraft>true</includeDraft>
                            <excludedMutators>
                                <excludedMutator>AvoidInlineConditionals</excludedMutator>
                                <excludedMutator>ForEachAddToStreamCollectToCollection</excludedMutator>
                                <excludedMutator>NullCheckToOptionalOfNullable</excludedMutator>
                                <excludedMutator>GuavaMutators</excludedMutator>
                                <excludedMutator>GuavaStringsIsNullOrEmpty</excludedMutator>
                                <excludedMutator>LoopIntRangeToIntStreamForEach</excludedMutator>
                                <excludedMutator>ForEachToIterableForEach</excludedMutator>
                                <excludedMutator>StreamForEachNestingForLoopToFlatMap</excludedMutator>
                                <excludedMutator>RemoveExplicitCallToSuper</excludedMutator>
                            </excludedMutators>
                        </cleanthat>
                        <importOrder>
                            <order>java,javax,com,de,lombok,net,org</order>
                        </importOrder>
                        <removeUnusedImports/>
                        <prettier>
                            <devDependencies>
                                <prettier>${prettier.version}</prettier>
                                <prettier-plugin-java>${prettier-plugin-java.version}</prettier-plugin-java>
                            </devDependencies>
                            <config>
                                <tabWidth>4</tabWidth>
                                <parser>java</parser>
                                <printWidth>120</printWidth>
                                <plugins>prettier-plugin-java</plugins>
                            </config>
                        </prettier>
                    </java>
                </configuration>
            </plugin>
            <!-- Needed by RHOS Java Build Pipeline -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>5.8.0.7211</version>
            </plugin>
            <!-- Make Pact Maven plugin's publish goal run by default-->
            <plugin>
                <groupId>au.com.dius.pact.provider</groupId>
                <artifactId>maven</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
