<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>ch.admin.bj.swiyu</groupId>
    <artifactId>swiyu-core-business-service</artifactId>
    <version>4.10.2-SNAPSHOT</version>
    <packaging>pom</packaging>
    <parent>
        <groupId>ch.admin.bit.jeap</groupId>
        <artifactId>jeap-spring-boot-parent</artifactId>
        <!--
            Attention: when ever you update this version, check whether we can remove a CVE-OVERRIDE
            from the dependencyManagement section
         -->
        <!-- see https://github.com/jeap-admin-ch/jeap-spring-boot-parent/blob/main/CHANGELOG.md -->
        <version>41.23.0</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.release>${java.version}</maven.compiler.release>
        <archunit-junit5.version>1.5.0</archunit-junit5.version>
        <maven-checkstyle-plugin.version>3.6.0</maven-checkstyle-plugin.version>
        <spotless-maven-plugin.version>3.10.2</spotless-maven-plugin.version>
        <cleanthat.version>2.25</cleanthat.version>
        <prettier.version>3.8.1</prettier.version>
        <prettier-plugin-java.version>2.8.1</prettier-plugin-java.version>
        <sonar.scm.disabled>true</sonar.scm.disabled>
        <!-- CVE-OVERRIDE start -->
        <!-- Override Tomcat to >= 11.0.27 to fix six Snyk findings on the embedded Tomcat 11.0.25
             that the parent's Spring Boot manages: -21716509 (critical, HTTP Request Smuggling,
             CVE-2026-86350), -21707477 (critical, Access Control Bypass, CVE-2026-101356),
             -21707475 (critical, Missing Critical Step in Authentication, CVE-2026-101296),
             -20552494 (critical, Authentication Bypass by Alternate Name, CVE-2026-76183),
             -21715436 (high, CVE-2026-78383) and -21246252 (high, CVE-2026-79677).
             11.0.27 is the first release fixing all six; the Snyk remediation hint (Spring Boot
             4.1.2) is not reachable, jEAP parent 41.23.0 (the latest) still manages Spring Boot
             4.1.1. The property is what the Spring Boot BOM reads for tomcat-embed-core, -el and
             -websocket, so all three move together.
             Remove when the parent manages Spring Boot with Tomcat >= 11.0.27. -->
        <tomcat.version>11.0.27</tomcat.version>
        <!-- Override PostgreSQL to >= 42.7.14 to fix SNYK-JAVA-ORGPOSTGRESQL-20571163 (high,
             Not Failing Securely / 'Failing Open', CVE-2026-107314). Spring Boot 4.1.1 manages
             42.7.13.
             Remove when the parent manages PostgreSQL >= 42.7.14. -->
        <postgresql.version>42.7.14</postgresql.version>
        <!-- CVE-OVERRIDE end -->
    </properties>


    <name>swiyu-core-business-service</name>
    <description>Parent aggregator for swiyu core business service and registry modules</description>

    <modules>
        <module>swiyu-core-business-service-app</module>
        <module>swiyu-core-business-service-registry-identifier</module>
        <module>swiyu-core-business-service-registry-status</module>
        <module>swiyu-discrete-validator-client</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ch.admin.bj.swiyu</groupId>
                <artifactId>swiyu-core-business-service-registry-identifier</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bj.swiyu</groupId>
                <artifactId>swiyu-core-business-service-registry-status</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.admin.bj.swiyu</groupId>
                <artifactId>swiyu-discrete-validator-client</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- CVE-OVERRIDE start -->
            <!-- CVE-2026-108106 and CVE-2026-93452 via kafka-clients, both fixed in 1.1.10.9; pinned to the
                 newest 1.1.10.x. Remove once kafka-clients pins 1.1.10.9 or later. -->
            <dependency>
                <groupId>org.xerial.snappy</groupId>
                <artifactId>snappy-java</artifactId>
                <version>1.1.10.12</version>
            </dependency>
            <!-- CVE-2026-102554, fixed in 33.7.2-jre. Reached via Pact (test) and kafka-schema-registry-client
                 (compile), and our main sources use @VisibleForTesting - hence no scope here. -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>33.7.2-jre</version>
            </dependency>
            <!-- CVE-OVERRIDE end -->

            <!-- commons-io is explicitly managed here because it is not provided by Spring Boot or jeap-parent.
                 Version 2.22.0 is used by swiyu-discrete-validator-client. -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>

        <plugins>
            <plugin>
                <!-- See https://www.baeldung.com/checkstyle-java for more info -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>${maven-checkstyle-plugin.version}</version>
                <configuration>
                    <!-- See https://checkstyle.sourceforge.io/config.html -->
                    <configLocation>google_checks.xml</configLocation>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <upToDateChecking>
                        <!--
                            upToDateChecking creates a cache in the target directory to only reformat modified files — improves performance.
                            Enabled by default since version 2.35.0, but explicitly set here so it can be temporarily disabled locally if merge issues occur.
                        -->
                        <enabled>true</enabled>
                    </upToDateChecking>
                    <java>
                        <includes>
                            <include>src/main/java/**/*.java</include>
                            <include>src/test/java/**/*.java</include>
                        </includes>
                        <cleanthat>
                            <version>${cleanthat.version}</version>
                            <sourceJdk>${java.version}</sourceJdk>
                            <mutators>
                                <mutator>SafeAndConsensual</mutator>
                                <mutator>SafeButNotConsensual</mutator>
                            </mutators>
                            <includeDraft>true</includeDraft>
                            <excludedMutators>
                                <excludedMutator>AvoidInlineConditionals</excludedMutator>
                                <excludedMutator>ForEachAddToStreamCollectToCollection</excludedMutator>
                                <excludedMutator>NullCheckToOptionalOfNullable</excludedMutator>
                                <excludedMutator>GuavaMutators</excludedMutator>
                                <excludedMutator>GuavaStringsIsNullOrEmpty</excludedMutator>
                                <excludedMutator>LoopIntRangeToIntStreamForEach</excludedMutator>
                                <excludedMutator>ForEachToIterableForEach</excludedMutator>
                                <excludedMutator>StreamForEachNestingForLoopToFlatMap</excludedMutator>
                                <excludedMutator>RemoveExplicitCallToSuper</excludedMutator>
                            </excludedMutators>
                        </cleanthat>
                        <importOrder>
                            <order>java,javax,com,de,lombok,net,org</order>
                        </importOrder>
                        <removeUnusedImports/>
                        <prettier>
                            <devDependencies>
                                <prettier>${prettier.version}</prettier>
                                <prettier-plugin-java>${prettier-plugin-java.version}</prettier-plugin-java>
                            </devDependencies>
                            <config>
                                <tabWidth>4</tabWidth>
                                <parser>java</parser>
                                <printWidth>120</printWidth>
                                <plugins>prettier-plugin-java</plugins>
                            </config>
                        </prettier>
                    </java>
                </configuration>
            </plugin>
            <!-- Needed by RHOS Java Build Pipeline -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>5.8.0.7211</version>
            </plugin>
            <!-- Make Pact Maven plugin's publish goal run by default-->
            <plugin>
                <groupId>au.com.dius.pact.provider</groupId>
                <artifactId>maven</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
